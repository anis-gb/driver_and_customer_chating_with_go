# Application Configuration
PORT=8080
APP_ENV=development

# PostgreSQL Database Configuration
# Format: postgres://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat-api?sslmode=disable

# HMAC Secret for signing (generate a strong random string for production)
HMAC_SECRET=your_long_random_secret_key_here
